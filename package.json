{
  "name": "siroclimb",
  "private": true,
  "type": "module",
  "description": "Siroclimb game front: landing, lobby, stairs game, results. Static site, Three.js scene, mock API.",
  "scripts": {
    "dev": "node --no-deprecation ops/dev-server.mjs",
    "test:solo": "node tests/app.mjs . out 1440 900 d solo",
    "test:round": "node tests/round.mjs . out",
    "test:intro": "node tests/intro.mjs . out",
    "test:ends": "node tests/ends.mjs . out",
    "build:vendor": "esbuild js/vendor/entry.mjs --bundle --format=esm --platform=browser --minify --target=es2020 --define:global=globalThis --outfile=js/vendor/solana.mjs --legal-comments=none"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "puppeteer-core": "^22.15.0",
    "three": "^0.160.1"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3"
  }
}
