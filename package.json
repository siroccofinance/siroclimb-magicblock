{
  "name": "siroclimb",
  "private": true,
  "type": "module",
  "description": "Siroclimb game front: landing, lobby, stairs game, results. Static site, Three.js scene, mock API.",
  "scripts": {
    "dev": "node --no-deprecation ops/dev-server.mjs",
    "test:solo": "node tests/app.mjs . out 1440 900 d solo",
    "test:intro": "node tests/intro.mjs . out",
    "test:ends": "node tests/ends.mjs . out",
    "build:vendor": "esbuild js/vendor/entry.mjs --bundle --format=esm --platform=browser --minify --target=es2020 --define:global=globalThis --outfile=js/vendor/solana.mjs --legal-comments=none",
    "battery": "node --no-deprecation ops/battery.mjs",
    "keeper": "node --no-deprecation ops/keeper.mjs",
    "probe": "node --no-deprecation ops/probe.mjs",
    "test:ui": "node ops/test/ui.mjs",
    "test:smoke": "node ops/test/smoke.mjs",
    "ci": "bash ops/ci-local.sh",
    "test:hours": "node --no-deprecation ops/test/hours-litesvm.mjs",
    "test:reserve": "node --no-deprecation ops/test/reserve-litesvm.mjs",
    "chain:deploy": "solana program deploy -u devnet --keypair $HOME/.config/siroclimb/solana/deployer.json --upgrade-authority $HOME/.config/siroclimb/solana/deployer.json --program-id $HOME/.config/siroclimb/solana/program.json chain/target/deploy/siroclimb.so --with-compute-unit-price 10000",
    "mirrors": "bash ops/mirrors.sh"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "litesvm": "^0.4.0",
    "puppeteer-core": "^22.15.0",
    "three": "^0.160.1"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^11.1.0"
    }
  }
}
